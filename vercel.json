{
  "version": 2,
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/public/**"
    }
  },
  "rewrites": [
    { "source": "/api/ping", "destination": "/api/ping.ts" },
    { "source": "/api/health", "destination": "/api/health.ts" },
    { "source": "/api/profile", "destination": "/api/profile.ts" },
    { "source": "/api/catalog", "destination": "/api/catalog.ts" },
    { "source": "/api/admin", "destination": "/api/admin.ts" },
    { "source": "/api/admin/(.*)", "destination": "/api/admin.ts" },
    { "source": "/api/trpc", "destination": "/api/trpc.ts" },
    { "source": "/api/trpc/(.*)", "destination": "/api/trpc.ts" },
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
